# {{ ansible_managed }}
storage:
  dbPath: /var/lib/mongodb

systemLog:
  destination: file
  logAppend: true
  path: /var/log/mongodb/mongod.log

net:
  port: {{ mongodb_port }}
  # Bound to localhost + the private subnet IP only — never 0.0.0.0.
  # The security group already blocks everything but the web server's SG,
  # this is defense-in-depth at the application layer too.
  bindIp: 127.0.0.1,{{ ansible_default_ipv4.address }}


{% if auth_enabled %}
security:
  authorization: enabled
{% endif %}
